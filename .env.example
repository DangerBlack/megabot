# --- required ---
TOKEN=your_telegram_bot_token            # from @BotFather
ROOT_USER_ID=123456789                   # your numeric Telegram ID: administrator, no budget
DB_PATH=./data

# --- text and photo models: list of OpenAI-compatible providers ---
# The first one is the default (or set DEFAULT_LLM). Users can switch with /llm.
# Each name NAME is configured with LLM_<NAME>_* variables.
LLM_PROVIDERS=local,openai
# DEFAULT_LLM=local

# Example: your own server (vLLM, Ollama, LM Studio, LiteLLM …)
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=none
LLM_LOCAL_CHAT_MODEL=llama3.1
# LLM_LOCAL_VISION_MODEL=llava            # default = CHAT_MODEL
# LLM_LOCAL_SUMMARY_MODEL=llama3.1        # default = CHAT_MODEL
# LLM_LOCAL_PRICE_IN=0                    # USD per million tokens, default 0 (free)
# LLM_LOCAL_PRICE_OUT=0

# OpenAI: also used for transcription and image generation
OPENAI_API_KEY=sk-...
# LLM_OPENAI_CHAT_MODEL=gpt-5.1
# LLM_OPENAI_SUMMARY_MODEL=gpt-5
# LLM_OPENAI_VISION_MODEL=gpt-5.1
# Estimated prices, check https://openai.com/api/pricing (USD per million tokens)
# LLM_OPENAI_PRICE_IN=1.25
# LLM_OPENAI_PRICE_OUT=10

# --- transcription and images (provider = one of the above, or none) ---
# TRANSCRIBE_PROVIDER=openai
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_PRICE_PER_MIN=0.006         # USD per minute, estimate
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=gpt-image-1
# IMAGE_PRICE=0.04                       # USD per image, estimate

# --- users ---
# DEFAULT_USER_BUDGET_USD=5              # monthly budget given by the "Accept" button

# --- web page summaries ---
# SUMMARY_MAX_CHARS=60000                # max text sent to the model (first 70% + last 30%)
# FETCH_FALLBACK=none                    # none | jina (retry blocked sites via r.jina.ai: the URL goes to a third party)
# JINA_API_KEY=

# --- conversations ---
# HISTORY_MAX_MESSAGES=20                # messages rebuilt when replying to the bot
# MESSAGE_RETENTION_DAYS=30              # stored messages are deleted after this

# HEALTHCHECK_URL=https://hc-ping.com/...  # GET every minute
