# --- obbligatori ---
TOKEN=your_telegram_bot_token            # da @BotFather (riusa quello del bot attuale)
ROOT_USER_ID=123456789                   # il tuo ID Telegram numerico: amministratore, nessun budget
DB_PATH=./data

# --- modelli di testo/foto: lista di provider compatibili OpenAI ---
# Il primo è il default (oppure DEFAULT_LLM). Ogni utente può cambiare con /llm.
LLM_PROVIDERS=mimir,openai
# DEFAULT_LLM=mimir

LLM_MIMIR_BASE_URL=https://llm.example.com/v1
LLM_MIMIR_API_KEY=sk-mimir-...
LLM_MIMIR_CHAT_MODEL=vllm/mimir
LLM_MIMIR_VISION_MODEL=vllm/mimir-vision
# LLM_MIMIR_SUMMARY_MODEL=vllm/mimir-slim   # default = CHAT_MODEL
# LLM_MIMIR_PRICE_IN=0                      # USD per milione di token, default 0
# LLM_MIMIR_PRICE_OUT=0

# OpenAI: serve per trascrizioni e immagini (e come LLM se in lista)
OPENAI_API_KEY=sk-...
# LLM_OPENAI_CHAT_MODEL=gpt-5.1
# LLM_OPENAI_SUMMARY_MODEL=gpt-5
# LLM_OPENAI_VISION_MODEL=gpt-5.1
# Prezzi stimati, DA VERIFICARE su openai.com/api/pricing (USD per milione di token)
# LLM_OPENAI_PRICE_IN=1.25
# LLM_OPENAI_PRICE_OUT=10

# --- trascrizione e immagini (provider = uno di quelli sopra, o none) ---
# TRANSCRIBE_PROVIDER=openai
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_PRICE_PER_MIN=0.006           # USD al minuto, da verificare
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=gpt-image-1
# IMAGE_PRICE=0.04                         # USD a immagine, da verificare

# --- utenti ---
# DEFAULT_USER_BUDGET_USD=5                # budget mensile del bottone "Accetta"

# --- riassunto pagine web ---
# SUMMARY_MAX_CHARS=60000                  # testo massimo passato al modello (taglio testa 70% + coda 30%)
# FETCH_FALLBACK=none                      # none | jina (r.jina.ai: l'URL passa da un servizio esterno)
# JINA_API_KEY=

# --- conversazione ---
# HISTORY_MAX_MESSAGES=20                  # messaggi ricostruiti quando rispondi al bot
# MESSAGE_RETENTION_DAYS=30                # dopo, i messaggi salvati vengono cancellati

# HEALTHCHECK_URL=https://hc-ping.com/...  # GET ogni minuto
